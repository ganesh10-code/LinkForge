# ==========================================
# LinkForge — Environment Configuration
# ==========================================
# Copy this file to .env and replace the values with your local settings.

# ------------------------------------------
# PostgreSQL Configuration (Local & Docker)
# ------------------------------------------
POSTGRES_DB=linkforge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ------------------------------------------
# Local Backend Configuration 
# (Overridden automatically by docker-compose in full Docker mode)
# ------------------------------------------
DB_URL=jdbc:postgresql://localhost:5433/linkforge
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
REDIS_HOST=localhost
REDIS_PORT=6379
FRONTEND_URL=http://localhost:5173

# ------------------------------------------
# Application Security & Settings
# ------------------------------------------
JWT_SECRET=replace_this_with_a_very_long_secure_secret_key_that_is_at_least_256_bits
JWT_EXPIRATION=172800000
PORT=9090

# ------------------------------------------
# Async Analytics Configuration
# ------------------------------------------
REDIS_DEFAULT_TTL_DAYS=7
ASYNC_CORE_POOL_SIZE=2
ASYNC_MAX_POOL_SIZE=10
ASYNC_QUEUE_CAPACITY=10000
