# Docker Compose Database Configuration
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password

# Application Configuration (Spring Boot)
DB_URL=jdbc:postgresql://localhost:5432/your_database
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
JWT_SECRET=your_jwt_secret_key_needs_to_be_long_enough
JWT_EXPIRATION=172800000
FRONTEND_URL=http://localhost:5173
PORT=9090

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DEFAULT_TTL_DAYS=7

# Async Analytics Configuration
ASYNC_CORE_POOL_SIZE=2
ASYNC_MAX_POOL_SIZE=10
ASYNC_QUEUE_CAPACITY=10000
